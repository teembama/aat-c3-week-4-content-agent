# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Firecrawl (free tier — https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-...

# App URL (used to build links in Discord notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Discord — review channel: fires when content enters pending_review
DISCORD_WEBHOOK_REVIEW=https://discord.com/api/webhooks/...

# Discord — approvals channel: fires on approve/reject/publish/unpublish/unapprove
DISCORD_WEBHOOK_APPROVALS=https://discord.com/api/webhooks/...

# Gmail SMTP — sends the newsletter when a newsletter channel is published.
# GMAIL_APP_PASSWORD is a Google App Password, not your account password
# (requires 2-Step Verification: https://myaccount.google.com/apppasswords).
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
